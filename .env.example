# Copy to .env for local development. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

# --- Auth ---
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Origin allowed by CORS. The web app's dev server.
WEB_ORIGIN=http://localhost:5173

# --- AI ---
# `stub` answers from fixed rules and needs no credentials, so the app runs and
# demos without a key. Switch to `claude` for real model calls.
LLM_PROVIDER=stub
# LLM_PROVIDER=claude

# Read by the SDK when LLM_PROVIDER=claude. Leave blank for the stub.
ANTHROPIC_API_KEY=""

# Haiku for both, pinned to a dated id so an alias cannot move under us.
# Swap AI_MODEL_CHAT to claude-sonnet-5 if tool calling needs a stronger model.
AI_MODEL_EXTRACTION=claude-haiku-4-5-20251001
AI_MODEL_CHAT=claude-haiku-4-5-20251001

AI_IMAGE_MAX_BYTES=8388608
AI_PDF_MAX_BYTES=15728640
AI_CHAT_MAX_TURNS=8
AI_CHAT_TOKEN_BUDGET=12000
AI_RATE_LIMIT_PER_MINUTE=20
